# =====================================================================
# Quran TV — Cloud & Data Platform Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Archive.org (Internet Archive S3 API)
# Get keys: https://archive.org/account/s3.php
# ---------------------------------------------------------------------
IA_ACCESS_KEY=your_archive_org_access_key_here
IA_SECRET_KEY=your_archive_org_secret_key_here
# Collection identifier / prefix for audio uploads (default: qurantv-audio)
IA_COLLECTION=qurantv-audio

# ---------------------------------------------------------------------
# 2. GitHub (Dataset Repository Sync & Versioning)
# Get token: https://github.com/settings/tokens/new
# ---------------------------------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token_here
# Target repo format: username/repo-name (e.g. yourname/qurantv-dataset)
GITHUB_REPO=your_username/your_repo_name
# Target branch for data commits (default: main)
GITHUB_BRANCH=main

# ---------------------------------------------------------------------
# 3. Studio / Server Config
# ---------------------------------------------------------------------
STUDIO_PORT=8765
WHISPER_MODEL=base
